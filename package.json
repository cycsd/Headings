{
	"name": "headings",
	"version": "2.1.0",
	"description": "Mind map, outline and tree table views of your note's headings. Navigate, edit in place, and drag and drop to restructure sections; plus commands to go to, copy, align and move headings.",
	"main": "main.js",
	"type": "module",
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"scripts": {
		"dev": "vite build --mode development --watch",
		"build": "svelte-check --tsconfig ./tsconfig.json && vite build",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"svelte-check": "svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"keywords": [
		"obsidian-plugin",
		"obsidian",
		"mind-map",
		"mindmap",
		"outline",
		"headings",
		"markdown",
		"drag-and-drop"
	],
	"license": "GNU General Public License v3.0",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@eslint/json": "0.14.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.7",
		"@tanstack/svelte-hotkeys": "^0.10.0",
		"@types/node": "^20.19.39",
		"@vitest/coverage-v8": "^4.1.5",
		"eslint-plugin-obsidianmd": "0.4.2",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"monkey-around": "^3.0.0",
		"svelte": "^5.55.4",
		"svelte-check": "^4.4.6",
		"svelte-preprocess": "^6.0.3",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.7",
		"tslib": "2.4.0",
		"typescript": "~5.0.0",
		"typescript-eslint": "8.35.1",
		"vite": "^7.1.0",
		"vitest": "^4.1.5"
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-markdown": "^6.5.0",
		"@codemirror/language-data": "^6.5.2",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.41.1",
		"@lezer/markdown": "^1.6.3",
		"@lucide/svelte": "^0.511.0",
		"@prosemark/core": "^0.0.6",
		"@prosemark/render-html": "^0.0.7",
		"clsx": "^2.1.1",
		"codemirror": "^6.0.2",
		"codemirror-live-markdown": "^0.5.1-alpha.1",
		"effect": "^4.0.0-rc.112",
		"obsidian": "latest",
		"svelte-codemirror-editor": "^2.1.0",
		"tailwind-merge": "^3.3.0",
		"tw-animate-css": "^1.3.0",
		"virtua": "^0.49.1"
	}
}
